{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client", "vite-plugin-glsl/ext"],
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/app/*": ["src/app/*"],
      "@/shared/*": ["src/shared/*"],
      "@/domains/*": ["src/domains/*"],
      "@xjicloud/spark": ["../../packages/spark/src/index.ts"],
      "@xjicloud/spark/*": ["../../packages/spark/src/*"],
      "@xjicloud/shared": ["../../packages/shared/src/index.ts"],
      "spark-rs": ["../../rust/spark-rs/pkg"],
      "spark-worker-rs": ["../../rust/spark-worker-rs/pkg"]
    },
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "../../packages/spark/src/**/*.ts",
    "../../packages/shared/src/**/*.ts"
  ]
}
