{
  "name": "@xjicloud/web2",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=24.14.0" },
  "scripts": {
    "predev": "node ../../scripts/copy-supersplat-dist.mjs web2 && node scripts/copy-native3dgs-assets.mjs",
    "dev": "vite",
    "prebuild": "node ../../scripts/copy-supersplat-dist.mjs web2 && node scripts/copy-native3dgs-assets.mjs",
    "build": "vue-tsc -b && vite build",
    "dev:viewer-demo": "node scripts/copy-native3dgs-assets.mjs demo && vite --config vite.viewer-demo.config.ts",
    "build:viewer-demo": "node scripts/copy-native3dgs-assets.mjs demo && vue-tsc --noEmit -p demo/native3dgs/tsconfig.json && vite build --config vite.viewer-demo.config.ts",
    "preview:viewer-demo": "vite preview --config vite.viewer-demo.config.ts",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest",
    "sky-gateway": "node scripts/sky-command-gateway.mjs"
  },
  "dependencies": {
    "@native3dgs/web": "file:vendor/native3dgs-web-0.2.2-preview.3.tgz",
    "@phosphor-icons/vue": "^2.2.1",
    "@xjicloud/shared": "workspace:*",
    "@xjicloud/sky-command-sdk": "file:vendor/xjicloud-sky-command-sdk-0.2.4.tgz",
    "@xjicloud/spark": "workspace:*",
    "cesium": "1.145.0",
    "flv.js": "^1.6.2",
    "motion": "^12.43.0",
    "three": "^0.180.0",
    "three-mesh-bvh": "^0.9.10",
    "three-player-controller": "^0.4.5",
    "vue": "^3.5.32",
    "vue-i18n": "^9.14.4",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "@webgpu/types": "0.1.74",
    "jsdom": "^26.1.0",
    "magic-string": "^0.30.21",
    "typescript": "~6.0.2",
    "vite": "^8.0.10",
    "vite-plugin-glsl": "^1.5.1",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.2.7"
  }
}
