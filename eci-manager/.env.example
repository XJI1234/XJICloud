# 复制为 eci-manager/.env 后填写（勿提交含密钥的 .env）
#
# 用法：
#   cd eci-manager
#   cp .env.example .env
#   ./scripts/start.sh
#
# 或手动： source scripts/load-env.sh && mvn spring-boot:run

# ---------- Spring ----------
SPRING_PROFILES_ACTIVE=cloud,local

# ---------- HTTP 鉴权（curl 请求头 X-Api-Key）----------
ECI_API_KEY=change-me-to-a-strong-key

# ---------- 阿里云凭证（调 ECI OpenAPI；yml 里的 access-key 字段已废弃）----------
ALIBABA_CLOUD_ACCESS_KEY_ID=your-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your-access-key-secret
# STS 临时凭证时取消注释：
# ALIBABA_CLOUD_SECURITY_TOKEN=your-security-token

# ---------- 网络（真云创建 ECI 必填）----------
ECI_REGION_ID=cn-hangzhou
ECI_VPC_ID=vpc-xxxxxxxx
ECI_VSWITCH_ID=vsw-xxxxxxxx
ECI_SECURITY_GROUP_ID=sg-xxxxxxxx

# ---------- 可选 ----------
# ECS 上部署时可用 RAM 角色，本机 WSL 一般留空
# ECI_ECS_RAM_ROLE_NAME=your-eci-manager-role

# 默认容器镜像（同地域建议 registry-vpc）
# ECI_DEFAULT_IMAGE=registry-vpc.cn-hangzhou.aliyuncs.com/eci_open/nginx:1.14.2

# Mock 开发（不用真云时改 SPRING_PROFILES_ACTIVE=dev）
# ECI_MOCK=true

