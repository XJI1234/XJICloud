# 复制为 eci-manager/.env 后填写（勿提交含密钥的 .env）
#
# 用法：
#   cd eci-manager
#   cp .env.example .env
#   ./scripts/start.sh
#
# 或手动： source scripts/load-env.sh && mvn spring-boot:run
# 本模板用于实际运行配置，不是 Mock 隔离验收步骤；验收时不要复制或加载真实 .env。
# Mock 验收须显式指定独立内存 H2，8080 代理与浏览器均连接该实例；见 docs/设计与使用说明.md §7。

# ---------- 非密钥云资源配置（Admin「云资源配置」页）----------
# 网络、OSS、高级共 15 项非密钥配置可在主项目 Admin 的「云资源配置」页保存。
# 优先级：数据库覆盖值 > 环境变量值（本文件的同名项）> 集中定义的默认值；
# 「恢复默认」只删除该分类的数据库覆盖行，不改本文件。
# 不纳入该页面：SPRING_PROFILES_ACTIVE、ECI_API_KEY、ALIBABA_CLOUD_*（含 STS）、
# ECI_ECS_RAM_ROLE_NAME、ECI_MOCK、ECI_CONSOLE_OPEN_BROWSER；云密钥仍由 Key 管理。

# ---------- Spring ----------
SPRING_PROFILES_ACTIVE=cloud,local

# ---------- HTTP 鉴权（进程唯一权威；curl 请求头 X-Api-Key）----------
# 修改后必须重启服务；HTTP Api-Key 不运行时热切，也不写入 H2。
# 升级时旧 H2 的 eci.api-key/previous/previous-expires-at 行会被完全忽略；
# 曾通过旧 PUT 轮换过的部署，升级前把当前有效钥回写到这里或部署 yml，再重启。
ECI_API_KEY=change-me-to-a-strong-key

# ---------- 阿里云凭证（调 ECI OpenAPI）----------
# 这是当前钥的「种子」：只在库里 current.ECI_OPENAPI 行不存在时写入。
# 已 PUT /runtime-credentials 的热切结果不会被下次启动的 .env 打回。
# 推荐直接填 ECI_ACCESS_KEY_*（绑定 eci.access-key-id/secret → 真实模式 STATIC_AK）
# ECI_ACCESS_KEY_ID=your-access-key-id
# ECI_ACCESS_KEY_SECRET=your-access-key-secret
#
# 兼容：Java 不读 ALIBABA_CLOUD_*。load-env.sh 仅在 ECI_ACCESS_KEY_* 为空且未设
# SECURITY_TOKEN 时把它映射成上面的种子。
# 仅使用兼容变量时取消注释并填写真实凭据；RAM 角色部署保持两组 AK 种子为空。
# ALIBABA_CLOUD_ACCESS_KEY_ID=your-access-key-id
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=your-access-key-secret
# STS 临时凭证时取消注释（此时不映射到 ECI_ACCESS_KEY_*，走 SDK 默认链）：
# ALIBABA_CLOUD_SECURITY_TOKEN=your-security-token

# ---------- 网络（真云创建 ECI 必填；也可在 Admin「云资源配置」页填写）----------
# 格式示例：vpc-xxxxxxxx / vsw-xxxxxxxx / sg-xxxxxxxx
ECI_REGION_ID=cn-hangzhou
ECI_VPC_ID=
ECI_VSWITCH_ID=
ECI_SECURITY_GROUP_ID=

# ---------- 可选 ----------
# ECS 上部署时可用 RAM 角色，本机 WSL 一般留空
# ECI_ECS_RAM_ROLE_NAME=your-eci-manager-role

# 默认容器镜像（同地域建议 registry-vpc）
# ECI_DEFAULT_IMAGE=registry-vpc.cn-hangzhou.aliyuncs.com/eci_open/nginx:1.14.2

# Mock 开发（不用真云时改 SPRING_PROFILES_ACTIVE=dev；仅切模式不隔离持久库，验收按 §7）
# ECI_MOCK=true

# ---------- OSS（storage 功能，联调时启用；密钥勿提交 Git）----------
# endpoint/bucket 是网络目标（不随选钥改）。AK/SK 是 OSS 当前钥种子（行不存在才写入）。
# 对接主项目时字段值与 xjicloud.oss 相同即可共享 Bucket
ECI_OSS_ENABLED=true
# 真云 ECI 任务请用内网：https://oss-cn-{region}-internal.aliyuncs.com（无 NAT 时公网会超时）
ECI_OSS_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com
ECI_OSS_REGION=cn-hangzhou
# 填写目标 Bucket 名；也可在 Admin「云资源配置」页保存。未配置完整时带 storage 的任务返回 400
ECI_OSS_BUCKET=
# 通常通过主后端 8080 选用 OSS 密钥并推送；仅首次手动初始化时填写以下种子。
# ECI_OSS_ACCESS_KEY=your-ram-access-key
# ECI_OSS_SECRET_KEY=your-ram-secret-key
ECI_OSS_PATH_STYLE_ACCESS=false
# 默认 1440 分钟；须覆盖镜像启动、训练与上传的总耗时，3DGS 长任务按需调大
ECI_OSS_PRESIGN_EXPIRATION_MINUTES=1440

# 可选：高级分类的创建超时（集中默认 1800 秒）。写入 .env 后由 start.sh 导出
# ECI_CREATE_TIMEOUT_SEC=1800

# 失败取证：删容器前拉日志尾部行数；宽限秒数（人可开控制台；0=抓完立刻删）
# ECI_FAILURE_LOG_TAIL_LINES=1000
# ECI_FAILURE_LOG_GRACE_SEC=90

# 启动后自动打开 http://127.0.0.1:8081/ ；CI/无桌面可关
# ECI_CONSOLE_OPEN_BROWSER=true

# 3DGS 标准档请在 POST 里传 shmSize=8Gi，不要把全局默认设成 8Gi（会砸 2Gi 小任务）。
# ECI_DEFAULT_SHM_SIZE=
