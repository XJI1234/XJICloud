# Copy to application-local.yml (gitignored) and fill in secrets.
# Start with: SPRING_PROFILES_ACTIVE=cloud,local mvn spring-boot:run
#
# WARNING: real ECI instances incur cost. Always DELETE when done.

eci:
  mock: false
  api-key: change-me-to-a-strong-key
  access-key-id: your-access-key-id
  access-key-secret: your-access-key-secret
  region-id: cn-hangzhou
  vpc-id: vpc-xxxxxxxx
  vswitch-id: vsw-xxxxxxxx
  security-group-id: sg-xxxxxxxx
  default-image: nginx:alpine
  default-cpu: 1.0
  default-memory: 2.0
  create-timeout-sec: 300
  poll-interval-ms: 3000
