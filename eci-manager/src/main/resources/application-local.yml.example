# Copy to application-local.yml (gitignored) and fill in non-secret settings.
# Start with: SPRING_PROFILES_ACTIVE=cloud,local mvn spring-boot:run
#
# Full config guide: docs/设计与使用说明.md §4.2
#
# WARNING: real ECI instances incur cost (GPU much higher). Always DELETE when done.
# Task path auto-deletes on Succeeded/Failed/TIMEOUT; still confirm in console.
#
# Cloud identity: eci.access-key-id/secret (or ECI_ACCESS_KEY_* / mapped ALIBABA_CLOUD_*)
# are the current-key *seed* — written only if the DB row is missing. Paired keys → STATIC_AK.
# Java does not read ALIBABA_CLOUD_*; load-env.sh maps them when ECI_ACCESS_KEY_* is empty.
#   Production ECS with empty current key: bind instance RAM role; set ecs-ram-role-name.
#   Without seed or role, startup may wait ~1–2s probing 100.100.100.200 then fail (expected).
#
# Create GPU example (POST body): instanceType=ecs.gn7i-c32g1.8xlarge, gpu=1
#   May fail with OperationDenied.NoStock if the vSwitch zone has no capacity.

eci:
  mock: false
  api-key: change-me-to-a-strong-key
  # Optional: ECS instance RAM role name (InstanceProfileCredentialsProvider)
  # ecs-ram-role-name: your-eci-manager-role
  region-id: cn-hangzhou
  vpc-id: vpc-xxxxxxxx
  vswitch-id: vsw-xxxxxxxx
  security-group-id: sg-xxxxxxxx
  # Real ECI: prefer Aliyun registry (Docker Hub often stays Pending without NAT)
  default-image: registry-vpc.cn-hangzhou.aliyuncs.com/eci_open/nginx:1.14.2
  default-cpu: 1.0
  default-memory: 2.0
  default-restart-policy: Never
  default-max-runtime-sec: 14400
  task-poll-interval-sec: 10
  create-timeout-sec: 300
  delete-timeout-sec: 300
  poll-interval-ms: 3000
  # Mock-only (ignored when mock=false); kept here for local mock overrides
  mock-auto-complete-sec: 3
  mock-auto-complete-status: Succeeded
