{
  "name": "xjicloud",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "pnpm --filter @xjicloud/web dev",
    "dev:web": "pnpm --filter @xjicloud/web dev",
    "dev:admin": "pnpm --filter @xjicloud/admin dev",
    "build": "pnpm --filter @xjicloud/web build",
    "build:web": "pnpm --filter @xjicloud/web build",
    "build:admin": "pnpm --filter @xjicloud/admin build",
    "build:all": "pnpm run build:web && pnpm run build:admin",
    "build:wasm": "node rust/build_wasm.js",
    "copy:supersplat": "node scripts/copy-supersplat-dist.mjs",
    "preview": "pnpm --filter @xjicloud/web preview"
  }
}
