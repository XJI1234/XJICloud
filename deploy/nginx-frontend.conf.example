# 前端专用 Nginx（前端与后端分机部署）
# 静态资源来自：
#   apps/web2/dist  → /var/www/xjicloud/
#   apps/admin/dist → /var/www/xjicloud/admin/
# 安装：/etc/nginx/conf.d/xjicloud-frontend.conf
#
# 替换：
#   your-domain.example     → 前端域名
#   10.0.1.20               → 后端服务器内网 IP 或域名
#   8080                    → 后端端口

server {
    listen 80;
    server_name your-domain.example;

    root /var/www/xjicloud;
    index index.html;

    client_max_body_size 2048m;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Native3DGS: module MIME and real 404s; do not add site-wide COOP/COEP.
    # Deploy the complete apps/web2/dist/gs-assets/ directory with this site.
    location ^~ /gs-assets/ {
        types {
            application/javascript js mjs;
            application/wasm wasm;
            application/json json;
            text/plain txt;
        }
        default_type application/octet-stream;
        try_files $uri =404;
    }

    location /admin/ {
        try_files $uri $uri/ /admin/index.html;
    }

    location /supersplat/ {
        alias /var/www/xjicloud/supersplat/;
        try_files $uri $uri/ /supersplat/index.html;
    }

    # API 反向代理到「后端服务器」（非本机）
    location /api/ {
        proxy_pass http://10.0.1.20:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
        proxy_cache off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        client_body_timeout 3600s;
        add_header X-Accel-Buffering no;
    }
}
