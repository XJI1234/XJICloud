# 可选：复制为 deploy.conf 以自定义安装路径
#   cp deploy.conf.example deploy.conf

INSTALL_DIR=/opt/xjicloud/backend
CONFIG_DIR=/etc/xjicloud
# 数据目录和服务端口以application-prod.yml为准，不在这里重复配置。
SERVICE_USER=xjicloud
SERVICE_NAME=xjicloud-backend
JAR_NAME=xjicloud-backend-1.0.0.jar
JAVA_BIN=/usr/bin/java
# PYTHON_BIN=/usr/bin/python3.9  # 需Python 3.8+及该解释器可导入PyYAML
