# 可选：复制为 backend.env，供 systemd 加载（覆盖/补充 JVM 与 Spring 环境变量）
#   cp backend.env.example backend.env
#
# 注意：主要配置请写在 application-prod.yml；此处适合放密钥或运维向变量。

# JAVA_OPTS=-Xms512m -Xmx2g

# 若希望通过环境变量覆盖数据库（需与 application-prod.yml 二选一或保持一致）：
# SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/xjicloud
# SPRING_DATASOURCE_USERNAME=xjicloud
# SPRING_DATASOURCE_PASSWORD=change-me

# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# 手机号注册：默认关闭，验证码有效期5分钟。
# 个人开发者短信认证：aliyun-pnvs，预置签名/模板，RAM权限 dypns:SendSmsVerifyCode。
# 原短信服务：aliyun-sms，自行审核签名/模板，RAM权限 dysms:SendSms。
# 验证码均由平台生成、Redis单次校验；不使用主账号AccessKey。
SMS_ENABLED=false
SMS_PROVIDER=aliyun-sms
# 仅 aliyun-pnvs 使用；选择带验证码和有效期变量的预置模板。
SMS_CODE_VARIABLE=code
SMS_MINUTES_VARIABLE=min
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
# 独立随机密钥，至少32字符，所有后端副本一致；不要复用 JWT / AccessKeySecret。
SMS_CODE_SECRET=
SMS_DAILY_LIMIT=1000
